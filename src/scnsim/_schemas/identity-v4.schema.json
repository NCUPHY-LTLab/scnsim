{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scnsim:schema:identity-v4",
  "title": "SCNSim evidence-v4 storage documents",
  "description": "Evidence binary framing/header and manifest/ref authority. OperationStore revision8 is distinct. Plan/Request/ParameterSet/authoring snapshot schema numbers and bytes remain unchanged in identity-v2. Workspace schema1 has required evidence_version4 in identity-common.",
  "oneOf": [
    {
      "$ref": "#/$defs/numericBlockHeader"
    },
    {
      "$ref": "#/$defs/objectReference"
    },
    {
      "$ref": "#/$defs/chunkManifest"
    },
    {
      "$ref": "#/$defs/sweepManifest"
    },
    {
      "$ref": "#/$defs/sensitivityManifest"
    },
    {
      "$ref": "#/$defs/optimizationManifest"
    },
    {
      "$ref": "#/$defs/directChunkSummary"
    }
  ],
  "$defs": {
    "numericBlockHeader": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "record",
        "columns",
        "context",
        "chunk_ordinal"
      ],
      "properties": {
        "schema": {
          "const": "scnsim.numeric_block"
        },
        "schema_version": {
          "const": 4
        },
        "record": {},
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "context": {
          "type": "object"
        },
        "chunk_ordinal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": [
        "ordinal",
        "path",
        "dtype",
        "byte_order",
        "shape",
        "order",
        "axes",
        "unit",
        "complex_representation",
        "offset",
        "byte_length",
        "representation"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "dtype": {
          "enum": [
            "bool",
            "int8",
            "uint8",
            "int16",
            "uint16",
            "int32",
            "uint32",
            "int64",
            "uint64",
            "float32",
            "float64",
            "complex64",
            "complex128"
          ]
        },
        "byte_order": {
          "const": "little"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "order": {
          "const": "C"
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "complex_representation": {
          "enum": [
            "interleaved_real_imag",
            "not_complex"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "representation": {
          "enum": [
            "array_record",
            "scalar_sequence"
          ]
        }
      },
      "additionalProperties": false
    },
    "objectReference": {
      "type": "object",
      "required": [
        "schema_version",
        "storage",
        "database",
        "role",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "schema_version": {
          "const": 8
        },
        "storage": {
          "const": "sqlite"
        },
        "database": {
          "const": "operations.sqlite3"
        },
        "role": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "chunkManifest": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "evidence_version",
        "workspace_instance_id",
        "plan_sha256",
        "request_sha256",
        "task_id",
        "attempt_id",
        "outcome",
        "request_ref",
        "metadata"
      ],
      "properties": {
        "schema": {
          "const": "scnsim.direct_manifest"
        },
        "schema_version": {
          "const": 1
        },
        "evidence_version": {
          "const": 4
        },
        "workspace_instance_id": {
          "type": "string"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "partial"
          ]
        },
        "request_ref": {
          "$ref": "#/$defs/objectReference"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "sweepManifest": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "evidence_version",
        "workspace_instance_id",
        "plan_sha256",
        "request_sha256",
        "task_id",
        "attempt_id",
        "outcome",
        "request_ref",
        "metadata"
      ],
      "properties": {
        "schema": {
          "const": "scnsim.sweep_manifest"
        },
        "schema_version": {
          "const": 1
        },
        "evidence_version": {
          "const": 4
        },
        "workspace_instance_id": {
          "type": "string"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "partial"
          ]
        },
        "request_ref": {
          "$ref": "#/$defs/objectReference"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "sensitivityManifest": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "evidence_version",
        "workspace_instance_id",
        "plan_sha256",
        "request_sha256",
        "task_id",
        "attempt_id",
        "outcome",
        "request_ref",
        "program_sha256",
        "quantity_layout",
        "derivative_layout"
      ],
      "properties": {
        "schema": {
          "const": "scnsim.sensitivity_manifest"
        },
        "schema_version": {
          "const": 1
        },
        "evidence_version": {
          "const": 4
        },
        "workspace_instance_id": {
          "type": "string"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "partial"
          ]
        },
        "request_ref": {
          "$ref": "#/$defs/objectReference"
        },
        "program_sha256": {
          "type": "string"
        },
        "quantity_layout": {},
        "derivative_layout": {}
      },
      "additionalProperties": false
    },
    "optimizationManifest": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "evidence_version",
        "workspace_instance_id",
        "plan_sha256",
        "request_sha256",
        "task_id",
        "attempt_id",
        "outcome",
        "request_ref",
        "declarations",
        "stage_ids"
      ],
      "properties": {
        "schema": {
          "const": "scnsim.optimization_manifest"
        },
        "schema_version": {
          "const": 1
        },
        "evidence_version": {
          "const": 4
        },
        "workspace_instance_id": {
          "type": "string"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "partial"
          ]
        },
        "request_ref": {
          "$ref": "#/$defs/objectReference"
        },
        "declarations": {
          "type": "object"
        },
        "stage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "directChunkSummary": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "workspace_instance_id",
        "plan_sha256",
        "request_sha256",
        "task_id",
        "attempt_id",
        "outcome",
        "ordinal",
        "evidence"
      ],
      "properties": {
        "schema": {
          "const": "scnsim.direct_chunk_summary"
        },
        "schema_version": {
          "const": 1
        },
        "workspace_instance_id": {
          "type": "string"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "partial"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "object",
          "required": [
            "terminal_ids",
            "axes",
            "realized_capabilities",
            "work_evidence"
          ],
          "properties": {
            "terminal_ids": {
              "type": "array"
            },
            "axes": {
              "type": "object"
            },
            "realized_capabilities": {
              "type": "array",
              "items": {
                "type": "boolean"
              }
            },
            "affine_evidence": {},
            "work_evidence": {
              "$ref": "#/$defs/directWorkEvidence"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "directWorkEvidence": {
      "description": "Work evidence of one Direct chunk as columns. Each counter and each certificate field is one array whose leading axis is the chunk's ordered work rows, so the number of arrays does not depend on the number of frequency points.",
      "type": "object",
      "required": [
        "work_index",
        "source_index",
        "check_status",
        "certificate_status",
        "check_position",
        "certificate_position",
        "certificates"
      ],
      "properties": {
        "work_index": {
          "$ref": "#/$defs/storedArray"
        },
        "source_index": {
          "$ref": "#/$defs/storedArray"
        },
        "check_status": {
          "$ref": "#/$defs/storedArray"
        },
        "certificate_status": {
          "$ref": "#/$defs/storedArray"
        },
        "check_position": {
          "$ref": "#/$defs/storedArray"
        },
        "certificate_position": {
          "$ref": "#/$defs/storedArray"
        },
        "certificates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/directCertificateColumns"
          }
        }
      },
      "additionalProperties": false
    },
    "directCertificateColumns": {
      "description": "One checked equation of the chunk: its identity once, and each field over the work rows.",
      "type": "object",
      "required": [
        "site",
        "role",
        "stage",
        "derivative_order",
        "status",
        "eta",
        "residual_numerator",
        "residual_denominator",
        "performed",
        "present"
      ],
      "properties": {
        "site": {
          "type": "array"
        },
        "role": {
          "type": "string"
        },
        "stage": {
          "type": "integer"
        },
        "derivative_order": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/storedArray"
        },
        "eta": {
          "$ref": "#/$defs/storedArray"
        },
        "residual_numerator": {
          "$ref": "#/$defs/storedArray"
        },
        "residual_denominator": {
          "$ref": "#/$defs/storedArray"
        },
        "performed": {
          "$ref": "#/$defs/storedArray"
        },
        "present": {
          "$ref": "#/$defs/storedArray"
        }
      },
      "additionalProperties": false
    },
    "storedArray": {
      "description": "A numeric array. Inside a stored block header it is the marker of its column; a reader returns the typed array.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "$scnsim_column_v4"
          ],
          "properties": {
            "$scnsim_column_v4": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "dtype",
            "shape",
            "data_hex"
          ],
          "properties": {
            "dtype": {
              "type": "string"
            },
            "shape": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "data_hex": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
