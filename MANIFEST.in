# Exact canonical knowledge inputs; QMD directives remain source text.
include README.md
include docs/agent-usage-inventory.json
include examples/engineer/setup.qmd
include docs/concepts/compilation-coordinates-and-network-views.qmd
include docs/concepts/requests-execution-and-result-ownership.qmd
